# Quant System runtime environment
QS_BIND=0.0.0.0:8080
QS_RUNS_ROOT=./runs
QS_DATASETS_CONFIG=configs/datasets.toml
QS_E2E_HOST=http://127.0.0.1:8080

# Rust logging. Works with env_logger/tracing-subscriber when enabled by the binary.
RUST_LOG=info,qs_app=debug,qs_api=debug,qs_orchestrator=debug,qs_storage=debug,qs_data=debug,qs_search=debug,qs_backtest=debug,qs_validation=debug,qs_export=debug
RUST_BACKTRACE=1

# UI dev server
QS_UI_HOST=0.0.0.0
QS_UI_PORT=3000
